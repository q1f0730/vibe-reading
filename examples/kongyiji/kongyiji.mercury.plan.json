 "utterances": [
  {
   "i": 3,
   "q": "孔乙己，你脸上又添上新伤疤了！",
   "sp": "jiuke"
  },
  {
   "i": 3,
   "q": "温两碗酒，要一碟茴香豆。",
   "sp": "kong"
  },
  {
   "i": 3,
   "q": "你怎么这样凭空污人清白……",
   "sp": "kong"
  },
  {
   "i": 5,
   "q": "孔乙己，你当真认识字么？",
   "sp": "jiuke"
  },
  {
   "i": 5,
   "q": "你怎的连半个秀才也捞不到呢？",
   "sp": "jiuke"
  },
  {
   "i": 6,
   "q": "你读过书么？",
   "sp": "kong"
  },
  {
   "i": 6,
   "q": "读过书，……我便考你一考。茴香豆的茴字，怎样写的？",
   "sp": "kong"
  },
  {
   "i": 6,
   "q": "不能写罢？……我教给你，记着！这些字应该记着。将来做掌柜的时候，写帐要用。",
   "sp": "kong"
  },
  {
   "i": 6,
   "q": "谁要你教，不是草头底下一个来回的回字么？",
   "sp": "wo"
  },
  {
   "i": 6,
   "q": "对呀对呀！……回字有四样写法，你知道么？",
   "sp": "kong"
  },
  {
   "i": 7,
   "q": "不多了，我已经不多了。",
   "sp": "kong"
  },
  {
   "i": 7,
   "q": "不多不多！多乎哉？不多也。",
   "sp": "kong"
  },
  {
   "i": 9,
   "q": "孔乙己长久没有来了。还欠十九个钱呢！",
   "sp": "zhang"
  },
  {
   "i": 9,
   "q": "他怎么会来？……他打折了腿了。",
   "sp": "jiuke"
  },
  {
   "i": 9,
   "q": "哦！",
   "sp": "zhang"
  },
  {
   "i": 9,
   "q": "后来怎么样？",
   "sp": "zhang"
  },
  {
   "i": 9,
   "q": "怎么样？先写服辩，后来是打，打了大半夜，再打折了腿。",
   "sp": "jiuke"
  },
  {
   "i": 9,
   "q": "后来呢？",
   "sp": "zhang"
  },
  {
   "i": 9,
   "q": "后来打折了腿了。",
   "sp": "jiuke"
  },
  {
   "i": 9,
   "q": "打折了怎样呢？",
   "sp": "zhang"
  },
  {
   "i": 9,
   "q": "怎样？……谁晓得？许是死了。",
   "sp": "jiuke"
  },
  {
   "i": 10,
   "q": "温一碗酒。",
   "sp": "kong"
  },
  {
   "i": 10,
   "q": "孔乙己么？你还欠十九个钱呢！",
   "sp": "zhang"
  },
  {
   "i": 10,
   "q": "这……下回还清罢。这一回是现钱，酒要好。",
   "sp": "kong"
  },
  {
   "i": 10,
   "q": "不要取笑！",
   "sp": "kong"
  },
  {
   "i": 10,
   "q": "跌断，跌，跌……",
   "sp": "kong"
  },
  {
   "i": 11,
   "q": "孔乙己还欠十九个钱呢！",
   "sp": "zhang"
  }
 ],
