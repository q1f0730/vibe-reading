 "utterances": [
  {
   "i": 1,
   "q": "样子太儍，怕侍候不了长衫主顾，就在外面做点事罢。",
   "sp": "boss"
  },
  {
   "i": 3,
   "q": "孔乙己，你脸上又添上新伤疤了！",
   "sp": "drinker"
  },
  {
   "i": 3,
   "q": "温两碗酒，要一碟茴香豆。",
   "sp": "kongyiji"
  },
  {
   "i": 3,
   "q": "你一定又偸了人家的东西了！",
   "sp": "drinker"
  },
  {
   "i": 3,
   "q": "你怎么这样凭空污人清白……",
   "sp": "kongyiji"
  },
  {
   "i": 3,
   "q": "什么清白？我前天亲眼见你偸了何家的书，吊着打。",
   "sp": "drinker"
  },
  {
   "i": 3,
   "q": "窃书不能算偸……窃书！……读书人的事，能算偸么？",
   "sp": "kongyiji"
  },
  {
   "i": 5,
   "q": "孔乙己，你当真认识字么？",
   "sp": "drinker"
  },
  {
   "i": 5,
   "q": "你怎的连半个秀才也捞不到呢？",
   "sp": "drinker"
  },
  {
   "i": 6,
   "q": "你读过书么？",
   "sp": "kongyiji"
  },
  {
   "i": 6,
   "q": "读过书，……我便考你一考。茴香豆的茴字，怎样写的？",
   "sp": "kongyiji"
  },
  {
   "i": 6,
   "q": "不能写罢？……我教给你，记着！这些字应该记着。将来做掌柜的时候，写帐要用。",
   "sp": "kongyiji"
  },
  {
   "i": 6,
   "q": "谁要你教，不是草头底下一个来回的回字么？",
   "sp": "narrator"
  },
  {
   "i": 6,
   "q": "对呀对呀！……回字有四样写法，你知道么？",
   "sp": "kongyiji"
  },
  {
   "i": 7,
   "q": "不多了，我已经不多了。",
   "sp": "kongyiji"
  },
  {
   "i": 7,
   "q": "不多不多！多乎哉？不多也。",
   "sp": "kongyiji"
  },
  {
   "i": 9,
   "q": "孔乙己长久没有来了。还欠十九个钱呢！",
   "sp": "boss"
  },
  {
   "i": 9,
   "q": "他怎么会来？……他打折了腿了。",
   "sp": "drinker"
  },
  {
   "i": 9,
   "q": "哦！",
   "sp": "boss"
  },
  {
   "i": 9,
   "q": "他总仍旧是偸。这一回，是自己发昏，竟偸到丁举人家里去了。他家的东西，偸得的么？",
   "sp": "drinker"
  },
  {
   "i": 9,
   "q": "后来怎么样？",
   "sp": "boss"
  },
  {
   "i": 9,
   "q": "怎么样？先写服辩，后来是打，打了大半夜，再打折了腿。",
   "sp": "drinker"
  },
  {
   "i": 9,
   "q": "后来呢？",
   "sp": "boss"
  },
  {
   "i": 9,
   "q": "后来打折了腿了。",
   "sp": "drinker"
  }
 ],
