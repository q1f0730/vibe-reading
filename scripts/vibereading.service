# systemd --user 单元：开机/重启后自动运行 VibeReading Web 服务（端口 3000）。
# 安装：mkdir -p ~/.config/systemd/user && cp scripts/vibereading.service ~/.config/systemd/user/
#       （按需修改 WorkingDirectory）systemctl --user daemon-reload && systemctl --user enable --now vibereading
#       sudo loginctl enable-linger "$USER"   # 未登录时也保持运行
# key 放在 ~/.config/vibereading.env（chmod 600），本文件不含任何 key。数据库与生成的书在 WorkingDirectory/data/。
[Unit]
Description=VibeReading web (accounts + shelf)
After=network-online.target

[Service]
WorkingDirectory=%h/vibe-reading
EnvironmentFile=-%h/.config/vibereading.env
Environment=INSTABOX_HEADLESS=1
Environment=VR_DATA_DIR=%h/vibe-reading/data
ExecStartPre=%h/vibe-reading/.venv/bin/python scripts/init_db.py
ExecStart=%h/vibe-reading/.venv/bin/python server.py --host 0.0.0.0 --port 3000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
